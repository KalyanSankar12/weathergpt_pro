# Copy this file to .env and fill in real values.
# .env is git-ignored and should NEVER be committed.

# When true, the app uses mock weather data and a rule-based chatbot —
# no external API keys required. Perfect for offline SIH demos.
DEMO_MODE=true

# OpenWeatherMap API key (free tier). Get one at https://openweathermap.org/api
# Only needed when DEMO_MODE=false
WEATHER_API_KEY=

# Anthropic API key. Optional — if left blank, WeatherGPT still works
# using the rule-based response templates instead of an LLM.
ANTHROPIC_API_KEY=
